# =============================================================================
# Autonomous AI SEO Manager & Operating System Environment Configuration
# =============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit .env with real secrets to version control.
# - The final production PostgreSQL host has intentionally NOT been fixed.
# - Configure the variables below according to your active deployment profile.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & SERVER
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# APP_URL: Base URL of the deployed application (used for OAuth callbacks and links)
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Choose the connection string corresponding to your execution profile:
#
# PROFILE A (Local Dev - Node runs on host machine, PostgreSQL in Docker):
# DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/ai_seo_manager?schema=public"
#
# PROFILE B (Full Docker Compose - Node & Worker run inside Docker containers):
# DATABASE_URL="postgresql://postgres:postgres_dev_password@postgres:5432/ai_seo_manager?schema=public"
#
# PROFILE C (Managed PostgreSQL - Supabase / Neon / Cloud SQL / RDS / Self-Hosted VPS):
# DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require"
#
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/ai_seo_manager?schema=public"
DIRECT_URL=

# -----------------------------------------------------------------------------
# 3. CACHE & BACKGROUND QUEUE BROKER (Redis)
# -----------------------------------------------------------------------------
# PROFILE A (Local Dev - Node on host, Redis in Docker):
# REDIS_URL="redis://localhost:6379"
#
# PROFILE B (Full Docker Compose):
# REDIS_URL="redis://redis:6379"
#
# PROFILE C (Managed / External Redis - Upstash / Aiven / Redis Cloud):
# REDIS_URL="rediss://default:<PASSWORD>@<HOST>:<PORT>"
#
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 4. SECURITY & CREDENTIAL VAULT (AES-256-GCM)
# -----------------------------------------------------------------------------
# ENCRYPTION_MASTER_KEY: 32-byte key (64 hex characters) used to encrypt integration
# credentials (GSC tokens, WordPress application passwords) at rest.
# Generate a secure 32-byte key using: openssl rand -hex 32
# Never use the example key in production environments.
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# 5. GOOGLE OAUTH & API INTEGRATIONS (Search Console & GA4)
# -----------------------------------------------------------------------------
# Required for connecting real Google Search Console and GA4 properties.
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# -----------------------------------------------------------------------------
# 6. AI ENGINE (Google Gemini API)
# -----------------------------------------------------------------------------
# Required for autonomous reasoning, content briefs, entity extraction, and CTR optimization.
# In Google AI Studio Build containers, this is injected automatically.
GEMINI_API_KEY=""
