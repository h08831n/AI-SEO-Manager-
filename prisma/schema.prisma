// Prisma Schema for Autonomous SEO Operating System
// Target: PostgreSQL (with timeseries, multi-tenant isolation, versioning, and partition-ready indices)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  SEO_MANAGER
  EDITOR
  ANALYST
  VIEWER
}

enum IntegrationProvider {
  GSC
  GA4
  WORDPRESS
  SHEETS
  RANK_TRACKER
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTING
  CONNECTED
  DEGRADED
  ERROR
  DISCONNECTED
  REVOKED
}

enum ActionStatus {
  RECOMMENDED
  PENDING_APPROVAL
  DRY_RUN
  DRY_RUN_VALIDATED
  EXECUTING
  AWAITING_VERIFICATION
  VERIFIED_COMPLETED
  FAILED
  BLOCKED
  UNVERIFIED_BLOCKED
  ROLLBACK_PENDING
  REVERTED_RESTORED
  // Compatibility aliases
  RECOMMENDATION_ONLY
  SIMULATION_ONLY
  BLOCKED_NO_INTEGRATION
}

enum AutomationRiskLevel {
  LEVEL_0_SUGGESTION_ONLY
  LEVEL_1_SAFE_AUTOMATION
  LEVEL_2_REVIEW_REQUIRED
  LEVEL_3_HIGH_RISK_MANUAL_ONLY
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum FrontierStatus {
  DISCOVERED
  QUEUED
  FETCHING
  FETCHED
  SKIPPED
  FAILED
  BLOCKED_ROBOTS
  BLOCKED_SCOPE
  BLOCKED_SECURITY
}

enum CrawlRunLifecycle {
  PENDING
  QUEUED
  RUNNING
  PAUSING
  PAUSED
  CANCELLING
  CANCELLED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

// ----------------------------------------------------
// Multi-Tenancy & RBAC Models
// ----------------------------------------------------

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  websites    Website[]
  auditLogs   AuditLog[]

  @@map("workspaces")
}

model User {
  id          String            @id @default(uuid())
  email       String            @unique
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships WorkspaceMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        UserRole  @default(VIEWER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}

model Website {
  id               String              @id @default(uuid())
  workspaceId      String
  domain           String
  name             String
  productionUrl    String
  sitemapUrl       String?
  defaultLanguage  String              @default("en-US")
  industry         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings         WebsiteSettings?
  integrations     Integration[]
  gscBinding       SearchConsolePropertyBinding?
  ga4Binding       Ga4PropertyBinding?
  syncRuns         IntegrationSyncRun[]
  gscFacts         GscSearchAnalyticsFact[]
  ga4LandingPages  Ga4LandingPageDaily[]
  ga4Channels      Ga4ChannelDaily[]
  urlIdentities    UrlIdentity[]
  crawlRuns        CrawlRun[]
  crawledPages     CrawledPage[]
  seoEvents        SeoEvent[]
  recommendations  SeoRecommendation[]
  tasks            SeoTask[]
  actionExecutions ActionExecution[]
  topicClusters    TopicCluster[]
  seoEntities      SeoEntity[]
  keywords         KeywordUniverse[]
  serpSnapshots    SerpSnapshot[]
  keywordRankFacts KeywordRankDaily[]
  serpEvents       SerpSnapshotEvent[]
  competitorDomains CompetitorDomain[]
  competitorFacts  CompetitorDailyFact[]
  actionPreStateSnapshots ActionPreStateSnapshot[]
  actionApprovalRequests ActionApprovalRequest[]
  auditLogs        AuditLog[]
  jobRuns          JobRun[]
  attributionFacts ActionAttributionFact[]
  syntheticControlMatches SyntheticControlMatch[]
  bayesianRuleWeightStates BayesianRuleWeightState[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@map("websites")
}

model WebsiteSettings {
  id                    String              @id @default(uuid())
  websiteId             String              @unique
  crawlFrequencyHours   Int                 @default(24)
  autoExecuteRiskLevel  AutomationRiskLevel @default(LEVEL_0_SUGGESTION_ONLY)
  targetGeo             String              @default("GLOBAL")
  primarySearchEngine   String              @default("google")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  website               Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

// ----------------------------------------------------
// Integrations & Google OAuth
// ----------------------------------------------------

model Integration {
  id                      String              @id @default(uuid())
  websiteId               String
  provider                IntegrationProvider
  status                  IntegrationStatus   @default(NOT_CONFIGURED)
  lastSyncAt              DateTime?
  accountIdentifier       String?
  connectedAccount        String?
  grantedScopes           String[]            @default([])
  tokenExpiry             DateTime?
  connectedAt             DateTime?
  lastRefreshAt           DateTime?
  lastSuccessfulApiCallAt DateTime?
  lastError               String?
  message                 String?
  encryptedCredentials    String?             // AES-256-GCM Encrypted JSON
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  website                 Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  gscBindings             SearchConsolePropertyBinding[]
  ga4Bindings             Ga4PropertyBinding[]
  syncRuns                IntegrationSyncRun[]

  @@unique([websiteId, provider])
  @@index([websiteId])
  @@map("integrations")
}

model SearchConsolePropertyBinding {
  id                   String      @id @default(uuid())
  websiteId            String      @unique
  integrationId        String
  providerPropertyId   String      // e.g. sc-domain:example.com or https://example.com/
  providerPropertyType String      // DOMAIN or URL_PREFIX
  permissionLevel      String      @default("SITE_RESTRICTED_USER")
  verifiedAt           DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  website              Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  integration          Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([providerPropertyId])
  @@map("search_console_property_bindings")
}

model Ga4PropertyBinding {
  id                   String      @id @default(uuid())
  websiteId            String      @unique
  integrationId        String
  providerAccountId    String?
  providerAccountName  String?
  providerPropertyId   String      // e.g. properties/123456789
  providerDisplayName  String?
  timeZone             String      @default("UTC")
  currencyCode         String      @default("USD")
  customKeyEvents      String[]    @default([])
  verifiedAt           DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  website              Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  integration          Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([providerPropertyId])
  @@map("ga4_property_bindings")
}

model OAuthStateSession {
  id           String              @id @default(uuid())
  state        String              @unique
  codeVerifier String?
  workspaceId  String
  userId       String
  websiteId    String?
  provider     IntegrationProvider @default(GSC)
  redirectUri  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([state, expiresAt])
  @@index([workspaceId, userId])
  @@map("oauth_state_sessions")
}

model IntegrationSyncRun {
  id                 String              @id @default(uuid())
  websiteId          String
  integrationId      String
  provider           IntegrationProvider
  dataset            String              // SEARCH_ANALYTICS, LANDING_PAGE_DAILY, CHANNEL_DAILY
  syncType           String              @default("INCREMENTAL_SYNC") // INITIAL_BACKFILL, INCREMENTAL_SYNC, MANUAL_RESYNC
  requestedStartDate DateTime            @db.Date
  requestedEndDate   DateTime            @db.Date
  status             String              @default("PENDING") // PENDING, QUEUED, RUNNING, COMPLETED, COMPLETED_WITH_WARNINGS, FAILED, CANCELLED
  rowsFetched        Int                 @default(0)
  rowsUpserted       Int                 @default(0)
  pagesFetched       Int                 @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  lastCursor         String?
  errorCode          String?
  errorMessage       String?
  retrievedAt        DateTime?
  correlationId      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  website            Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  integration        Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  gscFacts           GscSearchAnalyticsFact[]
  ga4LandingPages    Ga4LandingPageDaily[]
  ga4Channels        Ga4ChannelDaily[]

  @@index([websiteId, status])
  @@index([integrationId, provider])
  @@index([websiteId, requestedStartDate, requestedEndDate])
  @@map("integration_sync_runs")
}

// ----------------------------------------------------
// Technical Crawl & Site Graph Models
// ----------------------------------------------------

model UrlIdentity {
  id                String       @id @default(uuid())
  websiteId         String
  normalizedUrl     String
  pathname          String
  firstDiscoveredAt DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  discoverySources  String[]     @default(["SEED"]) // SEED, HTML_LINK, SITEMAP, REDIRECT, CANONICAL
  inlinksCount      Int          @default(0)
  outlinksCount     Int          @default(0)
  minCrawlDepth     Int          @default(0)
  isOrphanCandidate Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  website           Website                  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  gscFacts          GscSearchAnalyticsFact[]
  ga4LandingPages   Ga4LandingPageDaily[]
  treatmentControlMatches SyntheticControlMatch[]    @relation("TreatmentUrlRelation")
  controlTwinMatches SyntheticControlMatch[]       @relation("ControlUrlRelation")
  attributionFacts  ActionAttributionFact[]

  @@unique([websiteId, normalizedUrl])
  @@index([websiteId, isOrphanCandidate])
  @@map("url_identities")
}

model CrawlRun {
  id                  String            @id @default(uuid())
  websiteId           String
  status              CrawlRunLifecycle @default(PENDING)
  seedUrl             String
  configJson          String            // Serialized CrawlConfig
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  durationMs          Int?
  totalPages          Int               @default(0)
  totalIssues         Int               @default(0)
  urlsDiscovered      Int               @default(0)
  urlsQueued          Int               @default(0)
  urlsFetched         Int               @default(0)
  urlsSkipped         Int               @default(0)
  urlsFailed          Int               @default(0)
  robotsTxtStatus     String?
  robotsTxtHash       String?
  sitemapsDiscovered  String[]          @default([])
  triggerSource       String            @default("MANUAL")

  website             Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages               CrawledPage[]
  issues              CrawlIssue[]
  links               InternalLinkEdge[]
  frontierEntries     CrawlFrontierEntry[]
  events              SeoEvent[]

  @@index([websiteId, startedAt])
  @@index([websiteId, status])
  @@map("crawl_runs")
}

model CrawlFrontierEntry {
  id              String         @id @default(uuid())
  crawlRunId      String
  url             String
  normalizedUrl   String
  depth           Int            @default(0)
  priority        Int            @default(10)
  status          FrontierStatus @default(DISCOVERED)
  discoverySource String         @default("HTML_LINK") // SEED, SITEMAP, HTML_LINK, REDIRECT
  parentUrl       String?
  attemptCount    Int            @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  lockedUntil     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  crawlRun        CrawlRun       @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@unique([crawlRunId, normalizedUrl])
  @@index([crawlRunId, status, priority])
  @@index([crawlRunId, nextAttemptAt])
  @@map("crawl_frontier_entries")
}

model CrawledPage {
  id                     String       @id @default(uuid())
  websiteId              String
  crawlRunId             String
  url                    String
  normalizedUrl          String
  pathname               String
  statusCode             Int
  finalUrl               String?
  redirectCount          Int          @default(0)
  redirectChainJson      String?      // Hop array [{ source, destination, status }]
  loadTimeMs             Int          @default(0)
  contentLengthBytes     Int          @default(0)
  isIndexable            Boolean      @default(true)
  indexabilityStatus     String       @default("INDEXABLE")
  indexabilityReasons    String[]     @default([])
  canonicalUrl           String?
  normalizedCanonicalUrl String?
  canonicalMatch         Boolean      @default(true)
  title                  String?
  titleLength            Int          @default(0)
  metaDescription        String?
  metaDescLength         Int          @default(0)
  metaRobots             String?
  xRobotsTag             String?
  h1Tags                 String[]     @default([])
  h2Count                Int          @default(0)
  h3Count                Int          @default(0)
  wordCount              Int          @default(0)
  contentHash            String?      // SHA-256 hash of normalized visible text
  simHash                String?      // 64-bit SimHash hex for near-duplicate clustering
  isExactDuplicate       Boolean      @default(false)
  duplicateClusterId     String?
  isThinContent          Boolean      @default(false)
  isPossibleSoft404      Boolean      @default(false)
  soft404Confidence      Float        @default(0.0)
  internalInlinksCount   Int          @default(0)
  internalOutlinksCount  Int          @default(0)
  externalOutlinksCount  Int          @default(0)
  imagesCount            Int          @default(0)
  missingAltCount        Int          @default(0)
  schemaTypes            String[]     @default([])
  schemaStatus           String       @default("STRUCTURE_UNKNOWN")
  openGraphJson          String?
  twitterCardJson        String?
  hreflangsJson          String?
  crawlDepth             Int          @default(0)
  crawledAt              DateTime     @default(now())

  website                Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawlRun               CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  issues                 CrawlIssue[]

  @@unique([crawlRunId, normalizedUrl])
  @@index([websiteId, normalizedUrl])
  @@index([crawlRunId, statusCode])
  @@index([crawlRunId, isIndexable])
  @@map("crawled_pages")
}

model InternalLinkEdge {
  id                  String   @id @default(uuid())
  crawlRunId          String
  sourceUrlIdentityId String?
  targetUrlIdentityId String?
  sourceUrl           String
  targetUrl           String
  normalizedTarget    String
  anchorText          String?
  isInternal          Boolean  @default(true)
  rel                 String?
  isNofollow          Boolean  @default(false)
  targetStatusCode    Int?
  isBroken            Boolean  @default(false)
  createdAt           DateTime @default(now())

  crawlRun            CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, sourceUrl])
  @@index([crawlRunId, normalizedTarget])
  @@index([crawlRunId, isBroken])
  @@index([crawlRunId, sourceUrlIdentityId])
  @@index([crawlRunId, targetUrlIdentityId])
  @@map("internal_link_edges")
}

model CrawlIssue {
  id            String        @id @default(uuid())
  crawlRunId    String
  crawledPageId String?
  ruleKey       String
  ruleVersion   String        @default("1.0.0")
  type          String
  severity      IssueSeverity
  message       String
  evidence      String        // Serialized JSON evidence object
  impact        String
  resolved      Boolean       @default(false)
  createdAt     DateTime      @default(now())

  crawlRun      CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  crawledPage   CrawledPage?  @relation(fields: [crawledPageId], references: [id], onDelete: SetNull)

  @@index([crawlRunId, severity])
  @@index([crawlRunId, ruleKey])
  @@map("crawl_issues")
}

// ----------------------------------------------------
// SEO Domain Event Tracking (Dedicated Historical Event Model)
// ----------------------------------------------------

model SeoEvent {
  id               String    @id @default(uuid())
  websiteId        String
  crawlRunId       String?
  eventType        String    // CLICKS_DROP, IMPRESSIONS_DROP, POSITION_DROP, STRIKING_DISTANCE_OPPORTUNITY, ORPHAN_PAGE_RECEIVING_TRAFFIC, NEW_URL, STATUS_CHANGED, etc.
  entityType       String    // URL, SITE, QUERY, PAGE, CHANNEL, ROBOTS, SITEMAP
  entityUrl        String    @default("")
  beforeValue      String?   // Serialized previous state
  afterValue       String?   // Serialized observed state
  deltaNotes       String?
  details          String?   // Serialized event/signal payload JSON
  severity         String    @default("INFO") // CRITICAL, HIGH, MEDIUM, LOW, INFO
  source           String    @default("CRAWLER") // CRAWLER, GOOGLE_SEARCH_CONSOLE, GOOGLE_ANALYTICS_4, MANUAL
  provenance       String    @default("CALCULATED") // MEASURED_PROVIDER, CALCULATED, AI_INFERENCE
  eventFingerprint String?   // Deterministic identity for deduplication e.g. "websiteId:eventType:entity:window"
  detectedAt       DateTime  @default(now())

  website          Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawlRun         CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  attributionFacts ActionAttributionFact[]

  @@unique([websiteId, eventFingerprint])
  @@index([websiteId, detectedAt])
  @@index([websiteId, eventType])
  @@index([crawlRunId])
  @@map("seo_events")
}

// ----------------------------------------------------
// Analytics & Timeseries
// ----------------------------------------------------

model SearchAnalyticsDaily {
  id          String   @id @default(uuid())
  websiteId   String
  date        DateTime @db.Date
  query       String
  page        String
  device      String   @default("DESKTOP") // DESKTOP, MOBILE, TABLET
  country     String   @default("GLOBAL")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  @@unique([websiteId, date, query, page, device, country])
  @@index([websiteId, date])
  @@index([websiteId, query])
  @@index([websiteId, page])
  @@map("search_analytics_daily")
}

model GscSearchAnalyticsFact {
  id                 String              @id @default(uuid())
  websiteId          String
  syncRunId          String?
  urlIdentityId      String?
  providerPropertyId String?             // e.g. sc-domain:example.com or https://example.com/
  date               DateTime            @db.Date
  grain              String              @default("SITE_DAILY") // SITE_DAILY, PAGE_DAILY, QUERY_DAILY, PAGE_QUERY_DAILY, COUNTRY_DAILY, DEVICE_DAILY
  pageUrl            String?
  query              String?
  country            String              @default("GLOBAL")
  device             String              @default("ALL") // ALL, DESKTOP, MOBILE, TABLET
  searchType         String              @default("WEB") // WEB, IMAGE, VIDEO, NEWS, DISCOVER, GOOGLE_NEWS
  searchAppearance   String?
  dataState          String              @default("FINALIZED") // FINALIZED, FRESH, HOURLY_ALL
  clicks             Int                 @default(0)
  impressions        Int                 @default(0)
  ctr                Float               @default(0)
  position           Float               @default(0)
  provenance         String              @default("MEASURED_PROVIDER") // MEASURED_PROVIDER, CALCULATED
  urlMatchStatus     String              @default("MATCHED_URL_IDENTITY") // MATCHED_URL_IDENTITY, NORMALIZED_MATCH, UNMATCHED_PROVIDER_URL, EXTERNAL_OR_OUT_OF_SCOPE
  retrievedAt        DateTime            @default(now())

  website            Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  syncRun            IntegrationSyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  urlIdentity        UrlIdentity?        @relation(fields: [urlIdentityId], references: [id], onDelete: SetNull)

  @@unique([websiteId, date, grain, pageUrl, query, country, device, searchType, searchAppearance, providerPropertyId])
  @@index([websiteId, date])
  @@index([websiteId, grain, date])
  @@index([websiteId, pageUrl, date])
  @@index([websiteId, query, date])
  @@index([websiteId, providerPropertyId])
  @@index([syncRunId])
  @@index([urlIdentityId])
  @@map("gsc_search_analytics_facts")
}

model Ga4LandingPageDaily {
  id                 String              @id @default(uuid())
  websiteId          String
  syncRunId          String?
  urlIdentityId      String?
  providerPropertyId String?             // e.g. properties/123456789
  date               DateTime            @db.Date
  landingPageUrl     String
  channelGroup       String              @default("Organic Search")
  sessions           Int                 @default(0)
  engagedSessions    Int                 @default(0)
  activeUsers        Int                 @default(0)
  newUsers           Int                 @default(0)
  keyEvents          Int                 @default(0)
  totalRevenue       Float               @default(0)
  currency           String              @default("USD")
  dataState          String              @default("FINALIZED")
  provenance         String              @default("MEASURED_PROVIDER")
  urlMatchStatus     String              @default("MATCHED_URL_IDENTITY")
  retrievedAt        DateTime            @default(now())

  website            Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  syncRun            IntegrationSyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  urlIdentity        UrlIdentity?        @relation(fields: [urlIdentityId], references: [id], onDelete: SetNull)

  @@unique([websiteId, date, landingPageUrl, channelGroup, providerPropertyId])
  @@index([websiteId, date])
  @@index([websiteId, landingPageUrl, date])
  @@index([websiteId, providerPropertyId])
  @@index([syncRunId])
  @@index([urlIdentityId])
  @@map("ga4_landing_page_daily")
}

model Ga4ChannelDaily {
  id                  String              @id @default(uuid())
  websiteId           String
  syncRunId           String?
  providerPropertyId  String?             // e.g. properties/123456789
  date                DateTime            @db.Date
  defaultChannelGroup String
  sessions            Int                 @default(0)
  engagedSessions     Int                 @default(0)
  users               Int                 @default(0)
  newUsers            Int                 @default(0)
  keyEvents           Int                 @default(0)
  totalRevenue        Float               @default(0)
  currency            String              @default("USD")
  dataState           String              @default("FINALIZED")
  provenance          String              @default("MEASURED_PROVIDER")
  retrievedAt         DateTime            @default(now())

  website             Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  syncRun             IntegrationSyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([websiteId, date, defaultChannelGroup, providerPropertyId])
  @@index([websiteId, date])
  @@index([websiteId, providerPropertyId])
  @@index([syncRunId])
  @@map("ga4_channel_daily")
}

// ----------------------------------------------------
// Topical Authority & Knowledge
// ----------------------------------------------------

model TopicCluster {
  id            String         @id @default(uuid())
  websiteId     String
  pillarName    String
  pillarUrl     String
  searchVolume  Int            @default(0)
  coverageScore Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  subtopics     TopicSubtopic[]

  @@index([websiteId])
  @@map("topic_clusters")
}

model TopicSubtopic {
  id           String       @id @default(uuid())
  clusterId    String
  name         String
  searchVolume Int          @default(0)
  intent       String       @default("Informational")
  status       String       @default("PLANNED") // PUBLISHED, PLANNED, DRAFT, GAP
  url          String?
  entities     String[]     @default([])
  createdAt    DateTime     @default(now())

  cluster      TopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId])
  @@map("topic_subtopics")
}

// ----------------------------------------------------
// Rule & Scoring Versioning
// ----------------------------------------------------

model RuleDefinition {
  id          String        @id @default(uuid())
  ruleKey     String        @unique
  name        String
  category    String
  description String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions    RuleVersion[]

  @@map("rule_definitions")
}

model RuleVersion {
  id               String         @id @default(uuid())
  ruleDefinitionId String
  version          String         // e.g. 1.0.0
  severity         IssueSeverity  @default(MEDIUM)
  logicConfigJson  String         // Serialized rule parameter definitions
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  ruleDefinition   RuleDefinition @relation(fields: [ruleDefinitionId], references: [id], onDelete: Cascade)

  @@unique([ruleDefinitionId, version])
  @@index([ruleDefinitionId, isActive])
  @@map("rule_versions")
}

model ScoringProfile {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String?
  isDefault   Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  versions    ScoringProfileVersion[]

  @@map("scoring_profiles")
}

model ScoringProfileVersion {
  id                      String         @id @default(uuid())
  scoringProfileId        String
  version                 String         // e.g. 1.0.0
  weightsJson             String         // Serialized factor weights
  normalizationConfigJson String         // Normalization parameters
  missingDataBehavior     String         @default("FALLBACK_TO_ZERO")
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())

  scoringProfile          ScoringProfile @relation(fields: [scoringProfileId], references: [id], onDelete: Cascade)

  @@unique([scoringProfileId, version])
  @@index([scoringProfileId, isActive])
  @@map("scoring_profile_versions")
}

// ----------------------------------------------------
// Recommendations & Tasks
// ----------------------------------------------------

model SeoRecommendation {
  id                     String              @id @default(uuid())
  websiteId              String
  title                  String
  category               String
  actionType             String
  evidence               String
  source                 String
  ruleKey                String?
  ruleVersion            String?
  scoringProfileVersion  String?
  confidenceScore        Float               @default(0.8)
  impactScore            Int                 @default(5)
  effortScore            Int                 @default(5)
  riskScore              Int                 @default(3)
  businessValue          Int                 @default(5)
  automationLevel        AutomationRiskLevel @default(LEVEL_1_SAFE_AUTOMATION)
  status                 ActionStatus        @default(RECOMMENDED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  website                Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tasks                  SeoTask[]
  actionExecutions       ActionExecution[]

  @@index([websiteId, status])
  @@map("seo_recommendations")
}

model SeoTask {
  id                 String              @id @default(uuid())
  websiteId          String
  recommendationId   String?
  title              String
  category           String
  priority           String              @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  opportunityScore   Float               @default(50.0)
  automationLevel    AutomationRiskLevel @default(LEVEL_1_SAFE_AUTOMATION)
  status             ActionStatus        @default(RECOMMENDED)
  reason             String
  evidence           String
  affectedUrls       String[]            @default([])
  actionType         String
  actionPayloadJson  String?
  beforeStateJson    String?
  afterStateJson     String?
  idempotencyKey     String?             @unique
  scheduledFor       DateTime?
  executedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  website            Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  recommendation     SeoRecommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  actionExecutions   ActionExecution[]
  auditLogs          AuditLog[]

  @@index([websiteId, status])
  @@map("seo_tasks")
}

// ----------------------------------------------------
// Action Execution & Action Verification (Dedicated Models)
// ----------------------------------------------------

model ActionExecution {
  id                  String               @id @default(uuid())
  websiteId           String
  taskId              String?
  recommendationId    String?
  actionType          String
  targetUrl           String
  idempotencyKey      String               @unique
  requestedByUserId   String?
  approvalId          String?
  state               ActionStatus         @default(RECOMMENDED)
  attemptCount        Int                  @default(0)
  beforeEvidenceJson  String?
  afterEvidenceJson   String?
  failureReason       String?
  executedAt          DateTime?
  verifiedAt          DateTime?
  rollbackExecutionId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  website             Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  task                SeoTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  recommendation      SeoRecommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  verifications       ActionVerification[]
  preStateSnapshots   ActionPreStateSnapshot[]
  rollbackHistories   RollbackExecutionHistory[]
  attributionFact     ActionAttributionFact?

  @@index([websiteId, state])
  @@index([idempotencyKey])
  @@map("action_executions")
}

model ActionVerification {
  id                 String          @id @default(uuid())
  actionExecutionId  String
  status             ActionStatus    @default(AWAITING_VERIFICATION)
  expectedStateJson  String
  observedStateJson  String?
  isMatch            Boolean         @default(false)
  varianceNotes      String?
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())

  actionExecution    ActionExecution @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)

  @@index([actionExecutionId, status])
  @@map("action_verifications")
}

model ActionPreStateSnapshot {
  id                String          @id @default(uuid())
  actionExecutionId String
  websiteId         String
  checksum          String
  snapshotJson      String
  createdAt         DateTime        @default(now())

  actionExecution   ActionExecution @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)
  website           Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([actionExecutionId])
  @@index([websiteId])
  @@map("action_pre_state_snapshots")
}

model RollbackExecutionHistory {
  id                String          @id @default(uuid())
  actionExecutionId String
  reason            String
  restoredStateJson String
  success           Boolean
  actorId           String
  createdAt         DateTime        @default(now())

  actionExecution   ActionExecution @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)

  @@index([actionExecutionId])
  @@map("rollback_execution_histories")
}

model ActionApprovalRequest {
  id                String                      @id @default(uuid())
  websiteId         String
  actionType        String
  targetUrl         String
  ruleKey           String?
  payloadJson       String
  opportunityScore  Float                       @default(0.0)
  riskLevel         String                      @default("LEVEL_1_SAFE_AUTOMATION")
  state             String                      @default("PROPOSED")
  proposedBy        String                      @default("DECISION_ENGINE")
  approvedBy        String?
  approvalNotes     String?
  rejectionReason   String?
  actionExecutionId String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  website           Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  transitionLogs    ActionStateTransitionLog[]

  @@index([websiteId])
  @@index([state])
  @@index([createdAt])
  @@index([websiteId, state, createdAt])
  @@map("action_approval_requests")
}

model ActionStateTransitionLog {
  id                String                @id @default(uuid())
  approvalRequestId String
  fromState         String
  toState           String
  actorId           String
  reason            String?
  timestamp         DateTime              @default(now())

  approvalRequest   ActionApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@map("action_state_transition_logs")
}

// ----------------------------------------------------
// Immutable Audit Logging
// ----------------------------------------------------

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String
  websiteId   String?
  userId      String?
  taskId      String?
  action      String
  entityType  String
  entityId    String
  beforeState String?    // JSON string
  afterState  String?    // JSON string
  provenance  String     @default("SYSTEM")
  ipAddress   String?
  timestamp   DateTime   @default(now())

  // Note: ON DELETE RESTRICT prevents cascading removal of immutable audit history
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  website     Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  task        SeoTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, timestamp])
  @@index([websiteId, timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------
// Asynchronous Job Queue & Outbox Pattern
// ----------------------------------------------------

model JobRun {
  id                String    @id @default(uuid())
  websiteId         String?
  requestedByUserId String?
  queueName         String
  jobName           String
  jobId             String?
  payloadJson       String?
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  progressPct       Int       @default(0)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  website           Website?  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([queueName, status])
  @@index([websiteId, status])
  @@map("job_runs")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payloadJson   String
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  lockedUntil   DateTime?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

// ----------------------------------------------------
// Phase 4: Rank Tracking, SERP Intelligence & Entity Graph
// ----------------------------------------------------

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum FunnelStage {
  TOFU
  MOFU
  BOFU
  RETENTION
}

enum BusinessValueTier {
  TIER_1_CRITICAL
  TIER_2_HIGH
  TIER_3_MEDIUM
  TIER_4_LOW
  TIER_5_BENCHMARK
}

enum KeywordTrackingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum KeywordDiscoverySource {
  MANUAL_SEED
  GSC_INGESTION
  CRAWL_EXTRACTION
  COMPETITOR_GAP
  AI_EXPANSION
}

enum SerpFeatureType {
  AI_OVERVIEW
  FEATURED_SNIPPET
  PEOPLE_ALSO_ASK
  LOCAL_PACK
  KNOWLEDGE_PANEL
  TOP_STORIES
  VIDEO_CAROUSEL
  IMAGE_PACK
  SHOPPING_ADS
  SITE_LINKS
  POPULAR_PRODUCTS
  DISCUSSION_FORUMS
}

enum SerpDevice {
  DESKTOP
  MOBILE
}

enum SerpEventType {
  SERP_LAYOUT_CHANGED
  AI_OVERVIEW_APPEARED
  AI_OVERVIEW_DISAPPEARED
  FEATURED_SNIPPET_GAINED
  FEATURED_SNIPPET_LOST
  OUR_URL_LOST_POSITION
  OUR_URL_GAINED_POSITION
  COMPETITOR_ENTERED_TOP10
  COMPETITOR_OUTRANKED_US
  KEYWORD_CANNIBALIZATION_DETECTED
  KEYWORD_STRIKING_DISTANCE_REACHED
}

enum EntityType {
  PRODUCT
  SERVICE
  BRAND
  CONCEPT
  FEATURE
}

model SeoEntity {
  id                   String            @id @default(uuid())
  websiteId            String
  name                 String
  slug                 String
  entityType           EntityType        @default(CONCEPT)
  description          String?
  targetConversionGoal String?           // e.g. "Demo Signup", "Pricing Quote"
  pillarUrl            String?
  pillarUrlIdentityId  String?
  businessValue        BusinessValueTier @default(TIER_2_HIGH)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  website              Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keywords             KeywordUniverse[]

  @@unique([websiteId, slug])
  @@index([websiteId, entityType])
  @@map("seo_entities")
}

model KeywordUniverse {
  id                  String                @id @default(uuid())
  websiteId           String
  keyword             String                // Display keyword string
  normalizedKeyword   String                // Lowercase, trimmed query
  
  // Intent & Classification
  searchIntent        SearchIntent          @default(INFORMATIONAL)
  intentConfidence    Float                 @default(0.8)
  funnelStage         FunnelStage           @default(TOFU)
  businessValue       BusinessValueTier     @default(TIER_3_MEDIUM)
  conversionIntent    Boolean               @default(false)
  moneyKeyword        Boolean               @default(false)
  
  // Entity Graph & Target URL Linkage
  topicEntityId       String?
  topicEntityName     String?
  conversionGoal      String?
  targetUrl           String?
  targetUrlIdentityId String?
  clusterId           String?
  
  // Tracking & Lifecycle
  trackingStatus      KeywordTrackingStatus @default(ACTIVE)
  priority            Int                   @default(3) // 1-5
  tags                String[]              @default([])
  discoverySource     KeywordDiscoverySource @default(MANUAL_SEED)
  
  // Search Metrics & Provenance
  searchVolume        Int?
  cpc                 Float?
  competitionIndex    Float?
  metricSource        String?               // KEYWORD_PLANNER, DATAFORSEO, MANUAL
  metricRetrievedAt   DateTime?
  
  // Latest Snapshot Cached Ranks
  currentDesktopRank  Int?
  currentMobileRank   Int?
  previousDesktopRank Int?
  previousMobileRank  Int?
  bestRank            Int?
  firstRankedDate     DateTime?
  lastTrackedAt       DateTime?
  
  // Data Provenance
  provenanceSource    String                @default("MANUAL")
  provenanceMethod    String                @default("INITIAL_IMPORT")
  provenanceTimestamp DateTime              @default(now())

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  website             Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  seoEntity           SeoEntity?            @relation(fields: [topicEntityId], references: [id], onDelete: SetNull)
  rankDailyFacts      KeywordRankDaily[]
  serpSnapshots       SerpSnapshot[]
  serpEvents          SerpSnapshotEvent[]
  attributionFacts    ActionAttributionFact[]

  @@unique([websiteId, normalizedKeyword])
  @@index([websiteId, trackingStatus])
  @@index([websiteId, searchIntent])
  @@index([websiteId, businessValue])
  @@index([websiteId, funnelStage])
  @@index([topicEntityId])
  @@map("keyword_universe")
}

model SerpSnapshot {
  id                  String                @id @default(uuid())
  websiteId           String
  keywordId           String
  keywordText         String
  device              SerpDevice            @default(DESKTOP)
  countryCode         String                @default("US")
  languageCode        String                @default("en")
  locationCode        String?
  
  provider            String                // MOCK, DATAFORSEO, SERPAPI, GOOGLE_CSE
  rawPayloadHash      String
  rawResponseJson     String?               // Short-term JSON payload
  
  totalResults        BigInt?
  searchEngine        String                @default("google")
  
  // Target Domain Position In Snapshot
  ourRank             Int?
  ourRankedUrl        String?
  ourUrlIdentityId    String?
  ourPixelTop         Int?
  hasMultipleRankings Boolean               @default(false)
  
  // Data Provenance
  provenanceSource    String                @default("SERP_PROVIDER")
  provenanceMethod    String                @default("API_POLL")
  provenanceTimestamp DateTime              @default(now())
  
  snapshotDate        DateTime              @default(now())
  createdAt           DateTime              @default(now())

  website             Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword             KeywordUniverse       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  serpItems           SerpItem[]
  featureOccurrences  SerpFeatureOccurrence[]
  eventsEmitted       SerpSnapshotEvent[]

  @@index([websiteId, keywordId, snapshotDate])
  @@index([websiteId, snapshotDate])
  @@map("serp_snapshots")
}

model SerpItem {
  id                  String                @id @default(uuid())
  snapshotId          String
  position            Int                   // 1-100
  domain              String                // Normalized root domain
  url                 String
  title               String?
  snippet             String?
  displayUrl          String?
  
  isTargetWebsite     Boolean               @default(false)
  urlIdentityId       String?
  
  pixelHeight         Int?
  pixelTop            Int?
  
  createdAt           DateTime              @default(now())

  snapshot            SerpSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, position])
  @@index([snapshotId, domain])
  @@index([domain, position])
  @@map("serp_items")
}

model SerpFeatureOccurrence {
  id                   String               @id @default(uuid())
  snapshotId           String
  featureType          SerpFeatureType
  position             Int                  // Visual position index
  
  title                String?
  snippet              String?
  targetUrl            String?
  domain               String?
  sourceUrls           String[]             @default([])
  
  isTargetWebsiteCited Boolean              @default(false)
  targetUrlIdentityId  String?
  
  pixelHeight          Int?
  pixelTop             Int?
  rawFeatureJson       String?
  
  createdAt            DateTime             @default(now())

  snapshot             SerpSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, featureType])
  @@index([featureType, isTargetWebsiteCited])
  @@map("serp_feature_occurrences")
}

model KeywordRankDaily {
  id                    String              @id @default(uuid())
  websiteId             String
  keywordId             String
  date                  DateTime            @db.Date
  device                SerpDevice          @default(DESKTOP)
  countryCode           String              @default("US")
  
  rank                  Int?
  previousRank          Int?
  rankChange            Int?
  
  rankedUrl             String?
  rankedUrlIdentityId   String?
  isTargetUrlMatched    Boolean             @default(false)
  
  // Feature Aggregates
  hasFeaturedSnippet    Boolean             @default(false)
  hasAiOverviewCitation Boolean             @default(false)
  aiOverviewOnSerp      Boolean             @default(false)
  totalFeaturesOnSerp   Int                 @default(0)
  
  // Visibility Scoring
  visibilityWeight      Float               @default(0.0)
  visibilityScore       Float               @default(0.0)
  ctrModelUsed          String              @default("STANDARD_ORGANIC_V1")
  
  snapshotId            String?
  
  // Provenance
  provenanceSource      String              @default("SERP_INGESTION")
  provenanceMethod      String              @default("DAILY_AGGREGATE")
  provenanceTimestamp   DateTime            @default(now())

  createdAt             DateTime            @default(now())

  website               Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword               KeywordUniverse     @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([websiteId, keywordId, device, countryCode, date])
  @@index([websiteId, date])
  @@index([websiteId, keywordId, date])
  @@map("keyword_rank_daily")
}

model SerpSnapshotEvent {
  id               String            @id @default(uuid())
  websiteId        String
  keywordId        String
  snapshotId       String?
  eventType        SerpEventType
  severity         String            @default("INFO") // INFO, WARNING, CRITICAL
  
  description      String
  metadataJson     String
  
  recommendationId String?
  isActionable     Boolean           @default(false)
  isAcknowledged   Boolean           @default(false)
  
  createdAt        DateTime          @default(now())

  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          KeywordUniverse   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  snapshot         SerpSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([websiteId, eventType])
  @@index([websiteId, createdAt])
  @@map("serp_snapshot_events")
}

model CompetitorDomain {
  id                  String                @id @default(uuid())
  websiteId           String
  domain              String                // "competitor.com"
  name                String?
  isDirectCompetitor  Boolean               @default(true)
  isExcluded          Boolean               @default(false)
  isPlatform          Boolean               @default(false)
  exclusionReason     String?
  
  sharedKeywordsCount Int                   @default(0)
  outrankingCount     Int                   @default(0)
  outrankedByUsCount  Int                   @default(0)
  averagePosition     Float                 @default(0.0)
  visibilityIndex     Float                 @default(0.0)
  
  provenanceSource    String                @default("DISCOVERY_ENGINE")
  provenanceMethod    String                @default("SERP_OVERLAP_ANALYSIS")
  provenanceTimestamp DateTime              @default(now())

  lastCalculatedAt    DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  website             Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  dailyFacts          CompetitorDailyFact[]

  @@unique([websiteId, domain])
  @@index([websiteId, isDirectCompetitor])
  @@map("competitor_domains")
}

model CompetitorDailyFact {
  id                   String           @id @default(uuid())
  websiteId            String
  competitorId         String
  date                 DateTime         @db.Date
  
  sharedKeywords       Int              @default(0)
  top3Keywords         Int              @default(0)
  top10Keywords        Int              @default(0)
  averagePosition      Float            @default(0.0)
  visibilityScore      Float            @default(0.0)
  visibilityDifference Float            @default(0.0)
  
  createdAt            DateTime         @default(now())

  website              Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  competitor           CompetitorDomain @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([websiteId, date])
  @@map("competitor_daily_facts")
}

// ----------------------------------------------------
// Phase 6.1: Causal Attribution, Synthetic Control & Bayesian Weight Governance
// ----------------------------------------------------

model ActionAttributionFact {
  id                    String            @id @default(uuid())
  websiteId             String
  actionExecutionId     String            @unique
  urlIdentityId         String
  primaryKeywordId      String?
  seoEventId            String?
  ruleKey               String
  cmsProvider           String            // WORDPRESS, SHOPIFY, CUSTOM_API, STATIC_SITE
  pageArchetype         String            @default("GENERAL")
  
  // Temporal Lag Horizons
  executionDate         DateTime
  indexingDetectedDate  DateTime?
  baselineStartDate     DateTime          // T - 30d
  evaluationStartDate   DateTime          // T + 14d (or post-index detection)
  evaluationEndDate     DateTime          // T + 45d

  // Treatment Pre/Post Metrics
  preAvgRank            Float
  postAvgRank           Float
  rankDelta             Float             // preAvgRank - postAvgRank (+ = improved rank)
  preClicks30d          Int               @default(0)
  postClicks30d         Int               @default(0)
  clickLiftDelta        Int               @default(0)
  preImpressions30d     Int               @default(0)
  postImpressions30d    Int               @default(0)
  impressionLiftDelta   Int               @default(0)
  preCtr                Float             @default(0.0)
  postCtr               Float             @default(0.0)
  ctrDelta              Float             @default(0.0)

  // Synthetic Control & Causal Estimation
  syntheticControlDelta Float?            // Mean metric delta of matched control cohort
  netCausalLift         Float             // DiD isolated gain
  outcomeCategory       String            // WIN, LOSS, NEUTRAL, INCONCLUSIVE
  confidenceScore       Float             @default(0.0)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  website               Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  actionExecution       ActionExecution   @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)
  urlIdentity           UrlIdentity       @relation(fields: [urlIdentityId], references: [id], onDelete: Cascade)
  primaryKeyword        KeywordUniverse?  @relation(fields: [primaryKeywordId], references: [id], onDelete: SetNull)
  seoEvent              SeoEvent?         @relation(fields: [seoEventId], references: [id], onDelete: SetNull)
  syntheticControls     SyntheticControlMatch[]

  @@index([websiteId, ruleKey])
  @@index([outcomeCategory])
  @@index([executionDate])
  @@index([seoEventId])
  @@map("action_attribution_facts")
}

model SyntheticControlMatch {
  id                    String                 @id @default(uuid())
  websiteId             String
  treatmentUrlId        String
  controlUrlId          String
  attributionFactId     String?
  similarityScore       Float
  matchingFeaturesJson  String                 // Serialized weights and sub-scores
  baselinePreClicks     Int                    @default(0)
  baselinePostClicks    Int                    @default(0)
  baselinePreRank       Float?
  baselinePostRank      Float?
  createdAt             DateTime               @default(now())

  website               Website                @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  treatmentUrl          UrlIdentity            @relation("TreatmentUrlRelation", fields: [treatmentUrlId], references: [id], onDelete: Cascade)
  controlUrl            UrlIdentity            @relation("ControlUrlRelation", fields: [controlUrlId], references: [id], onDelete: Cascade)
  attributionFact       ActionAttributionFact? @relation(fields: [attributionFactId], references: [id], onDelete: SetNull)

  @@index([treatmentUrlId])
  @@index([controlUrlId])
  @@index([attributionFactId])
  @@map("synthetic_control_matches")
}

model BayesianRuleWeightState {
  id                    String            @id @default(uuid())
  websiteId             String
  ruleKey               String
  cmsProvider           String            @default("ALL")
  pageArchetype         String            @default("ALL")
  
  // Beta-Binomial Posterior State
  alphaPrior            Float             @default(2.0)
  betaPrior             Float             @default(2.0)
  observedWins          Int               @default(0)
  observedLosses        Int               @default(0)
  observedNeutrals      Int               @default(0)
  alphaPosterior        Float             @default(2.0)
  betaPosterior         Float             @default(2.0)
  
  // Policy Approval & Clamping State
  rawCalculatedWeight   Float             @default(1.0)
  approvedAppliedWeight Float             @default(1.0)
  isAutoDamped          Boolean           @default(false)
  approvalStatus        String            @default("AUTO_APPROVED") // AUTO_APPROVED, PENDING_REVIEW, LOCKED
  lastEvaluatedAt       DateTime          @default(now())
  lastApprovedAt        DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  website               Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, ruleKey, cmsProvider, pageArchetype])
  @@index([websiteId, approvedAppliedWeight])
  @@map("bayesian_rule_weight_states")
}

